# Local development overrides (preferred over .env when present)
# Copy this file to .env.local

MONGO_URL=mongodb://localhost:27017
DB_NAME=securefileshare_local

# Keep the rest consistent with your .env
CORS_ORIGINS=*
FRONTEND_BASE_URL=http://localhost:3000

# JWT secret (dev value)
SECRET_KEY=change-me

# Google OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=
