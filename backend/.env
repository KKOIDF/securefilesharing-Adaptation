# Default environment configuration (do not store real secrets here).
# For local dev overrides, use backend/.env.local (git-ignored).

MONGO_URL=mongodb://localhost:27017
DB_NAME=securefileshare_local
CORS_ORIGINS=*
SECRET_KEY=securekey-local-dev-change-me
FRONTEND_BASE_URL=http://localhost:3000

# Google OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=

# SMTP settings for email OTP delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OTP_EXPIRE_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
